@model QLK.Models.ViewModels.VerifyOTPViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác thực mã OTP - Hệ thống TKELog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 35px;
            border-radius: 15px;
            background: #ffffff;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .brand-title {
            color: #2a5298;
            font-weight: 700;
            text-align: center;
            margin-bottom: 10px;
        }

        .btn-primary {
            background-color: #2a5298;
            border-color: #2a5298;
            padding: 12px;
            font-weight: 600;
        }

            .btn-primary:hover {
                background-color: #1e3c72;
            }
        /* CSS tuỳ chỉnh cho ô nhập OTP */
        .otp-input {
            letter-spacing: 0.5em;
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h3 class="brand-title"><i class="fa-solid fa-shield-halved me-2"></i>Xác Thực OTP</h3>
        <p class="text-center text-muted small mb-4">
            Vui lòng nhập mã gồm 6 chữ số vừa được gửi đến Email của bạn. Mã này có hiệu lực trong 5 phút.
        </p>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                <div class="mt-1 small">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @using (Html.BeginForm("VerifyOTP", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-4">
                @Html.TextBoxFor(m => m.OTPCode, new
                {
                    @class = "form-control otp-input",
                    @placeholder = "------",
                    @required = "required",
                    @maxlength = "6",
                    @autocomplete = "off"
                })
                @Html.ValidationMessageFor(m => m.OTPCode, "", new { @class = "text-danger small d-block text-center mt-2" })
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
                <i class="fa-solid fa-check-circle me-2"></i> Xác nhận mã
            </button>

            <div class="text-center mt-3">
                <a href="@Url.Action("ForgotPassword", "Account")" class="small text-decoration-none fw-bold text-secondary">
                    <i class="fa-solid fa-rotate-right me-1"></i> Gửi lại mã
                </a>
                <span class="text-muted mx-2">|</span>
                <a href="@Url.Action("Login", "Account")" class="small text-decoration-none fw-bold text-secondary">
                    Hủy bỏ
                </a>
            </div>
        }
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>